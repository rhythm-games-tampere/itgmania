{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/Build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "windows",
      "displayName": "Windows (Ninja; run from a VS developer prompt)",
      "inherits": "base",
      "architecture": { "value": "x64", "strategy": "external" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "vs2022",
      "displayName": "Windows (Visual Studio 2022 solution)",
      "inherits": "base",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "linux",
      "displayName": "Linux",
      "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    },
    {
      "name": "macos-arm64",
      "displayName": "macOS (Apple silicon)",
      "inherits": "base",
      "cacheVariables": { "CMAKE_OSX_ARCHITECTURES": "arm64" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" }
    },
    {
      "name": "macos-x64",
      "displayName": "macOS (Intel)",
      "inherits": "base",
      "cacheVariables": { "CMAKE_OSX_ARCHITECTURES": "x86_64" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" }
    },
    {
      "name": "ci",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_C_COMPILER_LAUNCHER": "ccache",
        "CMAKE_CXX_COMPILER_LAUNCHER": "ccache",
        "CMAKE_MSVC_DEBUG_INFORMATION_FORMAT": "$<$<CONFIG:Debug,RelWithDebInfo>:Embedded>"
      }
    },
    { "name": "ci-windows", "inherits": ["ci", "windows"] },
    { "name": "ci-linux", "inherits": ["ci", "linux"] },
    { "name": "ci-macos-arm64", "inherits": ["ci", "macos-arm64"] },
    { "name": "ci-macos-x64", "inherits": ["ci", "macos-x64"] }
  ],
  "buildPresets": [
    { "name": "windows", "configurePreset": "windows", "configuration": "Release" },
    { "name": "vs2022", "configurePreset": "vs2022", "configuration": "Release" },
    { "name": "linux", "configurePreset": "linux", "configuration": "Release" },
    { "name": "macos-arm64", "configurePreset": "macos-arm64", "configuration": "Release" },
    { "name": "macos-x64", "configurePreset": "macos-x64", "configuration": "Release" },
    { "name": "ci-windows", "configurePreset": "ci-windows", "configuration": "Release" },
    { "name": "ci-linux", "configurePreset": "ci-linux", "configuration": "Release" },
    { "name": "ci-macos-arm64", "configurePreset": "ci-macos-arm64", "configuration": "Release" },
    { "name": "ci-macos-x64", "configurePreset": "ci-macos-x64", "configuration": "Release" }
  ]
}
